server {
  listen 80;

  location / {
    proxy_pass http://web-app:3000;
    proxy_http_version 1.1;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # The proxy overwrites both headers. Client-supplied values are never
    # forwarded to the application as the trusted identity.
    proxy_set_header x-ticketin-client-ip $remote_addr;
    proxy_set_header x-ticketin-proxy-assertion ${EDGE_PROXY_ASSERTION};
  }
}
